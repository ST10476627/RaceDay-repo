@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "My events";
}

<h2 class="rd-page-title">My events</h2>

@if (ViewBag.Error != null)
{
    <div class="rd-alert rd-alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0 && ViewBag.Error == null)
{
    <div class="rd-card text-center">
        You have not enrolled for any events yet.
        <div class="mt-3"><a class="btn rd-btn-outline" asp-controller="Home" asp-action="Index">Browse events</a></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (EnrolmentViewModel e in Model)
                {
                    <tr>
                        <td><a asp-controller="Home" asp-action="EventDetails" asp-route-id="@e.EventID">@e.EventName</a></td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><span class="rd-status rd-status-@e.Status.ToLower()">@e.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}