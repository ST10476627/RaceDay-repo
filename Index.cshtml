@model List<EventViewModel>
@{
    ViewData["Title"] = "Upcoming events";
}

<h2 class="mb-3">Upcoming events</h2>

<form method="get" class="rd-card mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search by name or location</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Event type</label>
            <select name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(ViewBag.Type == "Run")">Run</option>
                <option value="Walk" selected="@(ViewBag.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(ViewBag.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn rd-btn">Filter</button>
        </div>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0 && ViewBag.Error == null)
{
    <div class="rd-card text-center">No upcoming events match your search.</div>
}

<div class="row g-4">
    @foreach (EventViewModel e in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="rd-card rd-event h-100">
                @if (!string.IsNullOrEmpty(e.BannerUrl))
                {
                    <img src="@e.BannerUrl" alt="@e.EventName banner" class="rd-event-banner" />
                }
                <span class="rd-type rd-type-@e.EventType.ToLower()">@e.EventType</span>
                <h3 class="mt-2">@e.EventName</h3>
                <p class="rd-meta">@e.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                <p class="rd-meta">@e.Location &middot; @e.Distance km</p>
                <p>@e.EventDescription</p>
                <a class="btn rd-btn-outline" asp-controller="Home" asp-action="EventDetails" asp-route-id="@e.EventID">View details</a>
            </div>
        </div>
    }
</div>