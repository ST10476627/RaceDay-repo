@model List<OrganiserEnrolmentViewModel>
@{
    ViewData["Title"] = "Results";
    List<EventSummaryViewModel> events = ViewBag.Events;
    int? eventId = ViewBag.EventId;
}

<h2 class="rd-page-title">Results entry</h2>

@if (TempData["Success"] != null)
{
    <div class="rd-alert rd-alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="rd-alert rd-alert-danger">@TempData["Error"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="rd-alert rd-alert-danger">@ViewBag.Error</div>
}

<form method="get" class="rd-card mb-4">
    <label class="form-label">Choose an event</label>
    <select name="eventId" class="form-select" onchange="this.form.submit()">
        <option value="">Select an event...</option>
        @foreach (EventSummaryViewModel e in events)
        {
            <option value="@e.EventID" selected="@(eventId == e.EventID)">@e.EventName (@e.EventDate.ToString("dd MMM yyyy"))</option>
        }
    </select>
</form>

@if (eventId != null)
{
    @if (Model.Count == 0)
    {
        <div class="rd-card text-center">Nobody is enrolled for this event.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table rd-table">
                <thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th></th></tr></thead>
                <tbody>
                    @foreach (OrganiserEnrolmentViewModel en in Model)
                    {
                        <tr>
                            <td>@en.ParticipantName</td>
                            <td>@en.CategoryName</td>
                            @if (en.HasResult)
                            {
                                <td colspan="3"><span class="rd-status rd-status-confirmed">Result captured</span></td>
                            }
                            else
                            {
                                <form method="post" asp-action="CaptureResult">
                                    <input type="hidden" name="enrolmentId" value="@en.EnrolmentID" />
                                    <input type="hidden" name="eventId" value="@eventId" />
                                <td><input type="time" step="1" name="finishTime" class="form-control form-control-sm" required /></td>
                                <td><input type="number" min="1" name="finishPosition" class="form-control form-control-sm" required /></td>
                                <td><button type="submit" class="btn rd-btn btn-sm">Save</button></td>
                                </form>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}