@model List<ResultViewModel>
@{
    ViewData["Title"] = "My results";

    // turns 1 into 1st, 2 into 2nd, 47 into 47th and so on
    string Ordinal(int n)
    {
        if (n % 100 >= 11 && n % 100 <= 13) return n + "th";
        return (n % 10) switch
        {
            1 => n + "st",
            2 => n + "nd",
            3 => n + "rd",
            _ => n + "th"
        };
    }
}

<h2 class="rd-page-title">My results</h2>

@if (ViewBag.Error != null)
{
    <div class="rd-alert rd-alert-danger">@ViewBag.Error</div>
}

@if (Model.Count == 0 && ViewBag.Error == null)
{
    <div class="rd-card text-center">No results yet. They appear here after an Organiser captures them.</div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ResultViewModel r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                        <td>@Ordinal(r.FinishPosition) out of @r.TotalFinishers</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}