@model EventViewModel
@{
    bool isNew = Model.EventID == 0;
    string action = isNew ? "CreateEvent" : "EditEvent";
    ViewData["Title"] = isNew ? "New event" : "Edit event";
}

<h2 class="rd-page-title">@ViewData["Title"]</h2>

@if (TempData["Error"] != null)
{
    <div class="rd-alert rd-alert-danger">@TempData["Error"]</div>
}

<div class="rd-card" style="max-width: 640px;">
    <form method="post" asp-controller="Organiser" asp-action="@action" enctype="multipart/form-data">
        <input type="hidden" name="id" value="@Model.EventID" />

        <div class="mb-3">
            <label class="form-label">Event name</label>
            <input type="text" name="eventName" value="@Model.EventName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="eventDescription" class="form-control" rows="3">@Model.EventDescription</textarea>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Date and time</label>
                <input type="datetime-local" name="eventDate" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Distance (km)</label>
                <input type="number" step="0.1" min="0.1" name="distance"
                       value="@Model.Distance.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Event type</label>
                <select name="eventType" class="form-select">
                    <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
                    <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
                    <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Location</label>
                <input type="text" name="location" value="@Model.Location" class="form-control" required />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Banner image (jpg, png or webp, max 5 MB)</label>
            @if (!string.IsNullOrEmpty(Model.BannerUrl))
            {
                <div class="mb-2"><img src="@Model.BannerUrl" alt="Current banner" class="rd-banner-thumb" /></div>
            }
            <input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="form-control" />
        </div>

        <button type="submit" class="btn rd-btn">Save event <span class="rd-btn-arrow">&rarr;</span></button>
        <a class="btn rd-btn-outline ms-2" asp-action="Events">Cancel</a>
    </form>
</div>